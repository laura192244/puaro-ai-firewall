# Puaro configuration. Copy to .env and edit. Never commit real values.

# --- Gateway ---
# Comma-separated list of "tenant:label:key" demo accounts accepted by the gateway.
# In a real deployment, accounts would be provisioned in a database, not an env var.
# Roster used by the simulator (scripts/*.py) and dashboard demo buttons:
#   custA: client1/client2 (legit users), dev-ci (heavy legit), bot1..bot8 (distillation bots), hacker1
#   custB: clientb1 (legit user), attacker_b1 (new account, same origin as the custA botnet)
PUARO_DEMO_ACCOUNTS=custA:client1:sk-clienta1,custA:client2:sk-clienta2,custA:dev-ci:sk-devci,custA:bot1:sk-bot1,custA:bot2:sk-bot2,custA:bot3:sk-bot3,custA:bot4:sk-bot4,custA:bot5:sk-bot5,custA:bot6:sk-bot6,custA:bot7:sk-bot7,custA:bot8:sk-bot8,custA:hacker1:sk-hacker1,custB:clientb1:sk-clientb1,custB:attacker_b1:sk-custb-attacker1

# --- Upstream model ---
# "mock" (default, always works offline) or "ollama"
PUARO_MODEL_BACKEND=mock
PUARO_OLLAMA_HOST=http://localhost:11434
PUARO_OLLAMA_MODEL=qwen2.5:0.5b

# --- Firewall ---
# "auto" tries the native sentinel-core package first and falls back to regex if unavailable.
# "regex" forces the fallback firewall. "native" forces sentinel-core and errors if missing.
PUARO_FIREWALL_MODE=auto

# --- Secrets ---
# HMAC secret used to derive per-account trap phrases for Model DNA. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
PUARO_TRAP_HMAC_SECRET=change-me-to-a-random-64-char-hex-string

# --- Storage ---
PUARO_DB_PATH=./data/puaro.db
# How long raw prompt/response text is retained, in minutes, for the demo dashboard.
PUARO_RAW_TEXT_RETENTION_MINUTES=60

# --- Risk weights (must sum to 1.0) ---
PUARO_WEIGHT_RATE=0.25
PUARO_WEIGHT_TEMPLATES=0.20
PUARO_WEIGHT_REASONING=0.15
PUARO_WEIGHT_LINKED=0.25
PUARO_WEIGHT_COVERAGE=0.15

# --- Policy thresholds (0-100 risk score) ---
# threshold_slow is 50, not 40, deliberately: with the weights above, rate+templates
# alone can reach 45/100 for a high-volume single-template caller (e.g. a CI account)
# that shows zero reasoning-demand, linked-account or topic-coverage signal. 50 gives
# margin so pure volume+repetition can't cross into "slow" without another signal.
PUARO_THRESHOLD_SLOW=50
PUARO_THRESHOLD_HIDE_REASONING=55
PUARO_THRESHOLD_DECOY=70

# --- Signals ---
PUARO_SIGNAL_WINDOW_SECONDS=300
PUARO_RATE_CAP_PER_WINDOW=20
PUARO_TEMPLATE_SIMILARITY_THRESHOLD=0.5
PUARO_LINKED_ACCOUNT_CAP=3
PUARO_SLOWDOWN_SECONDS=1.5

# --- Origin trust ---
# true (default here): trust the client-supplied X-Forwarded-For header as the
# origin IP for fingerprinting. Needed for this local demo, since the simulator
# runs everything from one machine and uses this header to present many distinct
# fake origins. In a REAL deployment this MUST be false unless a trusted reverse
# proxy is guaranteed to overwrite this header itself — otherwise any client can
# freely spoof its own fingerprint (evading detection) or spoof an innocent
# party's IP (getting them wrongly blocked across tenants via collective immunity).
PUARO_TRUST_FORWARDED_HEADERS=true

# Reject request bodies larger than this many bytes (413), before parsing.
# Checks Content-Length only; a reverse proxy should also enforce a cap
# (e.g. nginx client_max_body_size) since chunked transfer without
# Content-Length can bypass an application-level check alone.
PUARO_MAX_REQUEST_BYTES=262144
